---
import Layout from "../layouts/Layout.astro";
import WeatherIsland from "../components/WeatherIsland.jsx";
import WindIsland from "../components/WindIsland.jsx";
---

<Layout title="Málaga Weather Dashboard">
  <main>
    <header>
      <h1>Málaga estadisticas del tiempo 🌴</h1>
      <p>Datos en tiempo real desde la API de Open-Meteo</p>
    </header>

    <div class="dashboard-grid">
      <div class="card">
        <WeatherIsland client:visible />
      </div>
      <div class="card">
        <WindIsland client:visible />
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  }
  header {
    text-align: center;
    margin-bottom: 3rem;
  }
  h1 {
    font-size: 3rem;
    
  }
  .dashboard-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    align-items: flex-start;
  }
  .card {
    border: solid 1px green;
    border-radius: 16px;    
  }
 

  @media (max-width: 768px) {
    h1 {
      font-size: 2.2rem;
    }
    header {
      margin-bottom: 1.5rem;
    }
    .dashboard-grid {
      gap: 16px;
    }
  }
</style>
